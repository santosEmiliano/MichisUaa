generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EstadoAnimal {
  Desaparecido
  Registrado
  NoRegistrado
}

model Colonia {
  idColonia   Int    @id @default(autoincrement())
  nombre      String @db.VarChar(100)
  descripcion String @db.VarChar(400)
  zona        String @db.VarChar(150)

  animales     Animal[]
  usuariosCols UsuarioCol[]

  @@map("Colonia")
}

model Animal {
  idAnimal            Int          @id @default(autoincrement())
  Colonia_idColonia   Int
  nombre              String       @db.VarChar(80)
  esterilizado        Boolean      @default(false) @db.TinyInt
  foto                String?      @db.VarChar(120)
  estado              EstadoAnimal @default(Registrado)
  fecha_nac           DateTime?
  fecha_esterilizacion DateTime?
  descripcion         String?      @db.VarChar(400)

  colonia       Colonia        @relation(fields: [Colonia_idColonia], references: [idColonia])
  avistamientos Avistamiento[]

  @@map("Animal")
}

model Usuario {
  idUsuario Int    @id @default(autoincrement())
  nombre    String @db.VarChar(90)
  email     String @unique @db.VarChar(80)
  password  String @db.VarChar(150)
  admin     Boolean @default(false) @db.TinyInt

  avistamientosRegistrados  Avistamiento[] @relation("RegistradoPor")
  avistamientosVerificados  Avistamiento[] @relation("VerificadoPor")
  usuariosCols              UsuarioCol[]

  @@map("Usuario")
}

model UsuarioCol {
  Colonia_idColonia  Int
  Usuario_idUsuario  Int

  colonia Colonia @relation(fields: [Colonia_idColonia], references: [idColonia], onDelete: Cascade)
  usuario Usuario @relation(fields: [Usuario_idUsuario], references: [idUsuario], onDelete: Cascade)

  @@id([Colonia_idColonia, Usuario_idUsuario])
  @@map("Usuario-Col")
}

model Avistamiento {
  idAvistamiento Int     @id @default(autoincrement())
  usuarioId      Int
  animalId       Int?
  verificadoPor  Int?
  foto           String? @db.VarChar(150)
  descripcion    String? @db.VarChar(400)
  verificado     Boolean @default(false)
  longitud       Decimal @db.Decimal(9, 1)
  latitud        Decimal @db.Decimal(9, 1)

  usuario    Usuario  @relation("RegistradoPor", fields: [usuarioId], references: [idUsuario])
  animal     Animal?  @relation(fields: [animalId], references: [idAnimal])
  verificador Usuario? @relation("VerificadoPor", fields: [verificadoPor], references: [idUsuario])

  @@map("Avistamiento")
}