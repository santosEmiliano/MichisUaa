generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EstadoAnimal {
  Desaparecido
  Registrado
  NoRegistrado
}

enum TipoNotificacion {
  avistamiento_nuevo
  avistamiento_verificado
  avistamiento_rechazado
  gato_desaparecido
  gato_nuevo
  sistema
}

model Colonia {
  idColonia   Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(100)
  descripcion String   @db.VarChar(400)
  zona        String   @db.VarChar(150)
  createdAt   DateTime @default(now()) @map("created_at")

  animales     Animal[]
  usuariosCols UsuarioCol[]

  @@map("Colonia")
}

model Animal {
  idAnimal             Int          @id @default(autoincrement())
  Colonia_idColonia    Int
  nombre               String       @db.VarChar(80)
  esterilizado         Boolean      @default(false) @db.TinyInt
  foto_url             String?      @db.VarChar(160)
  estado               EstadoAnimal @default(Registrado)
  fecha_nac            DateTime?
  fecha_esterilizacion DateTime?
  fecha_desaparicion   DateTime?
  descripcion          String?      @db.VarChar(400)
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  colonia       Colonia        @relation(fields: [Colonia_idColonia], references: [idColonia])
  avistamientos Avistamiento[]

  @@map("Animal")
}

model Usuario {
  idUsuario Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(90)
  email     String   @unique @db.VarChar(80)
  password  String   @db.VarChar(150)
  admin     Boolean  @default(false) @db.TinyInt
  pushToken String?  @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  avistamientosRegistrados Avistamiento[] @relation("RegistradoPor")
  avistamientosVerificados Avistamiento[] @relation("VerificadoPor")
  usuariosCols             UsuarioCol[]
  medallas                 Medalla[]
  notificaciones           Notificacion[]

  @@map("Usuario")
}

model UsuarioCol {
  Colonia_idColonia Int
  Usuario_idUsuario Int

  colonia Colonia @relation(fields: [Colonia_idColonia], references: [idColonia], onDelete: Cascade)
  usuario Usuario @relation(fields: [Usuario_idUsuario], references: [idUsuario], onDelete: Cascade)

  @@id([Colonia_idColonia, Usuario_idUsuario])
  @@map("Usuario-Col")
}

model Avistamiento {
  idAvistamiento Int      @id @default(autoincrement())
  usuarioId      Int
  animalId       Int?
  verificadoPor  Int?
  foto_url       String?  @db.VarChar(160)
  descripcion    String?  @db.VarChar(400)
  verificado     Boolean  @default(false)
  longitud       Decimal  @db.Decimal(10, 7)
  latitud        Decimal  @db.Decimal(10, 7)
  createdAt      DateTime @default(now()) @map("created_at")

  usuario     Usuario  @relation("RegistradoPor", fields: [usuarioId], references: [idUsuario], onDelete: Cascade)
  animal      Animal?  @relation(fields: [animalId], references: [idAnimal])
  verificador Usuario? @relation("VerificadoPor", fields: [verificadoPor], references: [idUsuario], onDelete: SetNull)

  @@map("Avistamiento")
}

model Medalla {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  tipo      String   @db.VarChar(50)
  nivel     Int      @default(1)
  ganadaAt  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [idUsuario], onDelete: Cascade)

  @@unique([usuarioId, tipo])
  @@map("Medalla")
}

model Notificacion {
  id          Int              @id @default(autoincrement())
  usuarioId   Int
  tipo        TipoNotificacion
  titulo      String           @db.VarChar(120)
  descripcion String           @db.VarChar(300)
  leida       Boolean          @default(false)
  url         String?          @db.VarChar(200)
  createdAt   DateTime         @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [idUsuario], onDelete: Cascade)

  @@map("Notificacion")
}